# ============================================================
# C 课程通用 Makefile (你可以直接读它来学 make)
# ============================================================
# 用法:
#   make                    -> 编译目录下所有 .c 程序
#   make lesson00-环境与第一个程序/hello    -> 只编译某一个
#   make clean              -> 删除所有编译出来的程序
#
# 语法要点:
#   变量名 = 值         定义变量
#   $(变量名)           使用变量
#   目标: 依赖           规则: 目标由依赖生成
#   <Tab>命令            注意必须是 Tab 缩进, 空格会报错!
# ============================================================

# 找出所有 .c 源文件 (find 命令的结果存进变量)
SRCS := $(shell find . -name "*.c")

# 可执行文件 = 源文件去掉 .c 后缀
BINS := $(SRCS:.c=)

# 默认目标: 编译全部
all: $(BINS)

# 模式规则: 任何一个"名字"都能由"名字.c"编译而来
#   $<  = 依赖 (源文件)     $@ = 目标 (可执行文件)
%: %.c
	g++ -x c $< -x none $$(pkg-config --libs easyx) -Wall -o $@
	@echo "==> 编译完成: ./$@"

# 清理: 删掉所有编译出来的可执行文件
clean:
	rm -f $(BINS)
	@echo "==> 清理完成"

.PHONY: all clean
